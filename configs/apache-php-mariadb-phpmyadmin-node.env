BOOTSTRAP_DRY_RUN=yes
BOOTSTRAP_NON_INTERACTIVE=yes
WEBSERVER=apache
INSTALL_PHP=yes
PHP_VERSIONS="8.3 8.2"
PHP_DEFAULT_VERSION=8.3
INSTALL_COMPOSER=yes
INSTALL_NODE=yes
NODE_VERSION=22
INSTALL_PNPM=no
INSTALL_YARN=no
DB_SERVER=mariadb
CONFIGURE_DEV_DB_USER=yes
DB_DEV_PASSWORD=Password123
INSTALL_POSTGRESQL=no
INSTALL_REDIS=no
INSTALL_PHPMYADMIN=yes
INSTALL_VIRTUALSERVERS=yes
PHPMYADMIN_ALIAS=/phpmyadmin
