# Core
BOOTSTRAP_TIMEZONE=Africa/Cairo
BOOTSTRAP_DRY_RUN=no
BOOTSTRAP_NON_INTERACTIVE=yes
BOOTSTRAP_LOG_ROOT=/var/log/web-dev-bootstrap
BOOTSTRAP_STATE_ROOT=/var/lib/web-dev-bootstrap
FORCE_REPAIR=no
SKIP_EXISTING=yes
# Optional override. By default this resolves dynamically from:
# SUDO_USER -> USER -> root
# DEV_USER=

# Web server
WEBSERVER=nginx

# PHP
INSTALL_PHP=yes
PHP_VERSIONS="8.2 8.3"
PHP_DEFAULT_VERSION=8.3
INSTALL_COMPOSER=yes
# Optional override. By default this resolves to DEV_USER.
# COMPOSER_DEV_USER=
ENABLE_PPA_ONDREJ_PHP=yes
PRIMARY_PHP_EXTENSIONS="mysql pgsql sqlite3 curl mbstring xml zip intl bcmath gd"

# Node
INSTALL_NODE=yes
NODE_MAJOR=22
ENABLE_NODESOURCE=yes
INSTALL_PNPM=yes
INSTALL_YARN=no

# Databases
DB_SERVER=mariadb
CONFIGURE_DEV_DB_USER=yes
# Optional override. Defaults to DEV_USER.
# DB_DEV_USER=
# Change this for real environments.
DB_DEV_PASSWORD=Password123
INSTALL_POSTGRESQL=yes
INSTALL_REDIS=yes

# Tools
INSTALL_PHPMYADMIN=no
INSTALL_VIRTUALSERVERS=no
PHPMYADMIN_ALIAS=/phpmyadmin
ENABLE_UNIVERSE=yes
